# ============================================================================
# CUTM MENTOR-MENTEE PLATFORM  —  ENVIRONMENT CONFIGURATION
# ----------------------------------------------------------------------------
# Copy this file to ".env" (or ".env.local") and fill in real values.
# Nothing else needs to change — edit credentials here and the app goes live.
# ============================================================================

# ---- Core application ------------------------------------------------------
# Public URL where the app is hosted (used in emails, meet links, callbacks).
APP_URL=http://localhost:3000
APP_NAME="CUTM Mentor-Mentee Platform"
NODE_ENV=development

# ---- Database (MongoDB) ----------------------------------------------------
# Local:   mongodb://127.0.0.1:27017/cutm_mentoring
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/cutm_mentoring
MONGODB_URI=mongodb://127.0.0.1:27017/cutm_mentoring

# ---- Authentication --------------------------------------------------------
# Generate a strong secret:  openssl rand -base64 48
# (or just run `npm run setup` — it fills this in for you and keeps it stable)
JWT_SECRET=change-me-to-a-long-random-secret-string
# Session lifetime in seconds (default 8 hours)
SESSION_TTL=28800

# ---- First / bootstrap Admin (created by `npm run seed`) -------------------
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@cutm.ac.in
SEED_ADMIN_PASSWORD=ChangeThisAdmin@123

# ---- Email (SMTP) ----------------------------------------------------------
# Any SMTP provider works (Google Workspace, Zoho, Outlook365, SES, etc.)
# For Gmail/Workspace use an App Password (not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mentoring@cutm.ac.in
SMTP_PASS=your-smtp-app-password
MAIL_FROM="CUTM Mentoring <mentoring@cutm.ac.in>"

# ---- Google Meet / Google Calendar (optional but recommended) --------------
# Used to auto-create Google Meet links for weekly + monthly meetings.
# Create a Service Account in Google Cloud, enable the Calendar API, and enable
# Domain-Wide Delegation so it can create events on behalf of GOOGLE_IMPERSONATE.
# If left blank, the platform falls back to generating a static Meet room link.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE=mentoring@cutm.ac.in
GOOGLE_CALENDAR_ID=primary

# ---- Scheduler / Cron ------------------------------------------------------
# Secret required to trigger the /api/cron/* endpoints (protects against abuse).
# Vercel Cron / GitHub Actions / any scheduler must send this as a bearer token.
CRON_SECRET=change-me-cron-secret
# When running the bundled worker (`npm run worker`) set this to "true".
ENABLE_INTERNAL_SCHEDULER=false
# Weekly mentor-mentee meeting: 0=Sun ... 6=Sat  (default Monday 10:00)
WEEKLY_MEETING_DAY=1
WEEKLY_MEETING_TIME=10:00
# Monthly parent meeting: day of month + time (default 1st, 11:00)
MONTHLY_MEETING_DOM=1
MONTHLY_MEETING_TIME=11:00
# Timezone used for scheduling
SCHEDULE_TZ=Asia/Kolkata
